using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Rubus";
  default-width: 800;
  default-height: 800;

  Adw.Breakpoint {
    condition ("max-width: 550sp")

    setters {
      split_view.collapsed: true;
      sidebar.mode: page;
    }
  }

  content: Adw.NavigationSplitView split_view {
    sidebar: Adw.NavigationPage {
      title: "Devices";

      Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        Adw.ViewSwitcherSidebar sidebar {
          stack: content_stack;
        }
      }
    };

    content: Adw.NavigationPage {
      title: "Rubus";

      Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        Adw.ViewStack content_stack {
          Adw.ViewStackPage {
            title: "Awesome Page 1";

            child: Adw.StatusPage {
              title: "something to go here in future";
            };
          }

          Adw.ViewStackPage {
            title: "Awesome Page 2";

            child: Adw.StatusPage {
              title: "something else to go here in future as well";
            };
          }
        }
      }
    };
  };
}
